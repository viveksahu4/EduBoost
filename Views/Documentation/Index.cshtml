@{
    ViewData["Title"] = "System Documentation";
    Layout = "/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .docs-container {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 32px;
            align-items: flex-start;
            margin-bottom: 60px;
        }

        @@media (max-width: 992px) {
            .docs-container {
                grid-template-columns: 1fr;
            }
            .docs-sidebar {
                position: static !important;
                max-height: none !important;
            }
        }

        .docs-sidebar {
            position: sticky;
            top: 90px;
            max-height: calc(100vh - 120px);
            overflow-y: auto;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        }

        .docs-search-input {
            width: 100%;
            padding: 8px 14px 8px 34px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--surface-soft);
            color: var(--text);
            font-size: 0.85rem;
            margin-bottom: 16px;
            outline: none;
            transition: all 0.2s;
        }

        .docs-search-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        .docs-nav-group-title {
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--muted);
            margin: 16px 0 8px 6px;
        }

        .docs-nav-group-title:first-of-type {
            margin-top: 0;
        }

        .docs-nav-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 12px;
            border-radius: 8px;
            font-size: 0.84rem;
            font-weight: 600;
            color: var(--muted);
            text-decoration: none;
            transition: all 0.15s ease;
            margin-bottom: 2px;
        }

        .docs-nav-link:hover {
            color: var(--primary);
            background: var(--surface-soft);
        }

        .docs-nav-link.active {
            color: var(--primary);
            background: rgba(37, 99, 235, 0.1);
            font-weight: 700;
        }

        .docs-content {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 22px;
            padding: 36px 42px;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
            color: var(--text);
            line-height: 1.68;
        }

        @@media (max-width: 576px) {
            .docs-content {
                padding: 24px 20px;
            }
        }

        .docs-section {
            padding-bottom: 40px;
            margin-bottom: 40px;
            border-bottom: 1px solid var(--border);
            scroll-margin-top: 90px;
        }

        .docs-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .docs-badge {
            font-size: 0.72rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .docs-badge-teacher {
            background: rgba(13, 148, 136, 0.12);
            color: #0d9488;
        }

        .docs-badge-admin {
            background: rgba(99, 102, 241, 0.12);
            color: #6366f1;
        }

        .docs-badge-dev {
            background: rgba(245, 158, 11, 0.12);
            color: #d97706;
        }

        .docs-callout {
            border-radius: 14px;
            padding: 16px 20px;
            margin: 20px 0;
            border-left: 4px solid var(--primary);
            background: var(--surface-soft);
        }

        .docs-callout-tip {
            border-left-color: #10b981;
            background: rgba(16, 185, 129, 0.06);
        }

        .docs-callout-warning {
            border-left-color: #f59e0b;
            background: rgba(245, 158, 11, 0.06);
        }

        .docs-callout-info {
            border-left-color: #3b82f6;
            background: rgba(59, 130, 246, 0.06);
        }

        .code-box {
            position: relative;
            background: #0f172a;
            color: #e2e8f0;
            border-radius: 12px;
            padding: 16px 20px;
            font-family: 'Consolas', 'Courier New', monospace;
            font-size: 0.86rem;
            margin: 16px 0;
            overflow-x: auto;
        }

        .code-box-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
            color: #94a3b8;
            font-size: 0.74rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .copy-code-btn {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            border-radius: 6px;
            color: #cbd5e1;
            font-size: 0.72rem;
            padding: 3px 8px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .copy-code-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
        }

        .step-card {
            display: flex;
            gap: 16px;
            margin: 18px 0;
        }

        .step-num {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--primary);
            color: #ffffff;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 0.9rem;
        }

        .api-pill {
            font-family: monospace;
            font-size: 0.76rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 6px;
        }
        .api-get { background: #dbeafe; color: #1d4ed8; }
        .api-post { background: #dcfce7; color: #15803d; }
        .api-put { background: #fef3c7; color: #b45309; }
        .api-delete { background: #fee2e2; color: #b91c1c; }
    </style>
}

<div class="docs-container">
    <!-- Left Navigation Table of Contents -->
    <aside class="docs-sidebar">
        <div class="position-relative">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="position-absolute text-muted" style="top: 11px; left: 12px;">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" class="docs-search-input" id="docsSearchInput" placeholder="Filter documentation topics..." onkeyup="filterDocs()" />
        </div>

        <div id="docsNavMenu">
            <div class="docs-nav-group-title">Overview</div>
            <a href="#quickstart" class="docs-nav-link active">🚀 System Architecture</a>
            <a href="#core-concepts" class="docs-nav-link">💡 Core Philosophy</a>
            <a href="#ui-themes" class="docs-nav-link">🌓 UI Shell &amp; Themes</a>

            <div class="docs-nav-group-title">Roles &amp; Workflows</div>
            <a href="#teacher-guide" class="docs-nav-link">🧑‍🏫 Teacher Guide</a>
            <a href="#admin-guide" class="docs-nav-link">👑 Administrator Guide</a>
            <a href="#developer-guide" class="docs-nav-link">💻 Developer Setup</a>

            <div class="docs-nav-group-title">Features &amp; Engines</div>
            <a href="#risk-engine" class="docs-nav-link">🧠 Diagnostic Risk Engine</a>
            <a href="#ai-chatbot" class="docs-nav-link">💬 24/7 AI Chatbot (Gemini)</a>
            <a href="#remedial-plans" class="docs-nav-link">📋 Remedial Action Plans</a>
            <a href="#vark-modalities" class="docs-nav-link">🎨 VARK Learning Styles</a>
            <a href="#ai-integration" class="docs-nav-link">✨ AI Plan Generator</a>

            <div class="docs-nav-group-title">Authentication &amp; API</div>
            <a href="#social-auth-setup" class="docs-nav-link">🔑 Google OAuth Setup</a>
            <a href="#api-reference" class="docs-nav-link">🔌 REST API Endpoints</a>
            <a href="#faq-troubleshooting" class="docs-nav-link">❓ FAQ &amp; Troubleshooting</a>
        </div>
    </aside>

    <!-- Main Documentation Content Body -->
    <main class="docs-content">
        
        <!-- SECTION 1: ARCHITECTURE OVERVIEW -->
        <section class="docs-section" id="quickstart">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="docs-badge docs-badge-dev">Architecture</span>
                <span class="text-muted small">&bull; Updated November 2026</span>
            </div>
            <h1 class="display-6 fw-bold mb-3">EduBoost Documentation & Service Hub</h1>
            <p class="lead text-muted">
                EduBoost is an intelligent diagnostic learning analytics platform designed to identify academically fragile or slow learners early, match them with targeted remedial teaching methods, and build sustained capacity through multi-week action plans.
            </p>

            <div class="row g-3 my-3">
                <div class="col-md-4">
                    <div class="p-3 rounded-4 border bg-light bg-opacity-50 h-100">
                        <div class="fw-bold text-dark mb-1">🧑‍🏫 For Teachers</div>
                        <p class="small text-muted mb-0">Record assessments, observe attendance, calculate learning styles, and run AI remedial plans for struggling students.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-4 border bg-light bg-opacity-50 h-100">
                        <div class="fw-bold text-dark mb-1">👑 For Administrators</div>
                        <p class="small text-muted mb-0">Manage institutional subjects, oversee pedagogical methods library, run cohort diagnostics, and audit risk scores.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-4 border bg-light bg-opacity-50 h-100">
                        <div class="fw-bold text-dark mb-1">💻 For Developers</div>
                        <p class="small text-muted mb-0">Full ASP.NET Core 10 architecture, Entity Framework Core models, Identity Claims, REST APIs, and Swagger docs.</p>
                    </div>
                </div>
            </div>

            <div class="docs-callout docs-callout-info">
                <strong>System Access Credentials (Localhost Demo):</strong><br />
                &bull; <strong>Administrator:</strong> <code>admin@eduboost.local</code> / <code>Admin@123</code><br />
                &bull; <strong>Teacher:</strong> <code>teacher@eduboost.local</code> / <code>Teacher@123</code><br />
                &bull; Self-registration automatically assigns the <strong>Teacher</strong> role.
            </div>
        </section>

        <!-- SECTION 1B: CORE PHILOSOPHY -->
        <section class="docs-section" id="core-concepts">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="docs-badge docs-badge-teacher">Philosophy</span>
            </div>
            <h2 class="h3 fw-bold mb-3">Core Philosophy &amp; Intervention Pipeline</h2>
            <p class="text-muted">
                EduBoost replaces reactive end-of-term failure reports with a continuous four-stage early intervention loop:
            </p>
            <div class="row g-3 my-2">
                <div class="col-md-6">
                    <div class="p-3 rounded-4 border h-100">
                        <div class="fw-bold mb-1">1. Early Signal Detection</div>
                        <p class="small text-muted mb-0">Combines academic averages, attendance percentage, and chronological exam trends to flag vulnerability before final exams.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-4 border h-100">
                        <div class="fw-bold mb-1">2. Cognitive Modality Profiling</div>
                        <p class="small text-muted mb-0">Maps each student to Visual, Auditory, Reading/Writing, or Kinesthetic preferences via an in-app VARK diagnostic quiz.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-4 border h-100">
                        <div class="fw-bold mb-1">3. AI-Assisted Remediation</div>
                        <p class="small text-muted mb-0">Pairs Google Gemini and Anthropic Claude with deterministic pedagogical templates and a 24/7 AI Teaching Assistant.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-4 border h-100">
                        <div class="fw-bold mb-1">4. Measurable Recovery Tracking</div>
                        <p class="small text-muted mb-0">Captures weekly session logs and pre/post-intervention test deltas to verify learning recovery.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 1C: UI SHELL, THEMES & LANDING PORTAL -->
        <section class="docs-section" id="ui-themes">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="docs-badge docs-badge-dev">UI / UX Architecture</span>
            </div>
            <h2 class="h3 fw-bold mb-3">SaaS Shell, Light/Dark Themes &amp; Landing Portal</h2>
            <p class="text-muted">
                The platform uses a unified responsive shell (<code>Views/Shared/_Layout.cshtml</code> and <code>wwwroot/css/site.css</code>) with executive KPI cards across all core modules:
            </p>
            <ul class="text-muted small">
                <li><strong>Light &amp; Dark Mode Toggle:</strong> Switches between Clean Off-White (<code>data-theme="light"</code>) and Sleek Charcoal Dark (<code>data-theme="dark"</code>), persisted in <code>localStorage</code> under <code>eduboost-theme</code> and applied pre-paint to prevent theme flash.</li>
                <li><strong>Collapsible Navigation Sidebar:</strong> Desktop collapse state persists in <code>eduboost-sidebar-collapsed</code>, featuring quick links to <strong>Documentation Hub</strong> (<code>/Documentation</code>) and <strong>API Docs (Swagger)</strong> (<code>/swagger</code>).</li>
                <li><strong>Modernized Landing Showcase (<code>/Home/Index</code>):</strong> Built in <code>Views/Home/Index.cshtml</code> and <code>wwwroot/css/home.css</code> with a 3D floating analytics preview card, one-click demo credential copy chips, a Bento capabilities grid, and a direct <strong>Ask 24/7 AI</strong> hero trigger.</li>
                <li><strong>Split-Card Auth Pages:</strong> <code>Login.cshtml</code> and <code>Register.cshtml</code> use <code>_AuthLayout.cshtml</code> and <code>wwwroot/css/auth.css</code> with a 24/7 AI Assistant banner and simulated/live social SSO modal.</li>
                <li><strong>Live Notification Center:</strong> <code>_NotificationDropdown.cshtml</code> polls <code>GET /api/notifications</code> for high-risk student alerts, active remedial plans, and low assessment warnings.</li>
            </ul>
        </section>

        <!-- SECTION 2: TEACHER GUIDE -->
        <section class="docs-section" id="teacher-guide">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="docs-badge docs-badge-teacher">Teacher Guide</span>
            </div>
            <h2 class="h3 fw-bold mb-3">Teacher Operations & Daily Workflow</h2>
            <p class="text-muted">
                As an educator, EduBoost helps you identify struggling learners before they fail exams, pinpointing root causes across attendance, test trends, and individual learning modalities.
            </p>

            <h4 class="h5 fw-bold mt-4 mb-3">Standard Step-by-Step Workflow:</h4>

            <div class="step-card">
                <div class="step-num">1</div>
                <div>
                    <h5 class="h6 fw-bold mb-1">Enrolling Students</h5>
                    <p class="text-muted small mb-0">Navigate to <strong>Students &rarr; + Add Student</strong>. Record the student's Roll Number, Full Name, Class/Section, Parent Email, and Attendance Percentage.</p>
                </div>
            </div>

            <div class="step-card">
                <div class="step-num">2</div>
                <div>
                    <h5 class="h6 fw-bold mb-1">Recording Assessments</h5>
                    <p class="text-muted small mb-0">Go to <strong>Assessments &rarr; + Record Marks</strong>. Select the student, subject (Mathematics, Science, English), exam type (Surprise Test, Midterm, Quiz), and marks obtained against maximum marks. The system automatically calculates percentage and registers the exam date.</p>
                </div>
            </div>

            <div class="step-card">
                <div class="step-num">3</div>
                <div>
                    <h5 class="h6 fw-bold mb-1">Identifying Slow Learners</h5>
                    <p class="text-muted small mb-0">Visit the <strong>Slow Learners</strong> dashboard. Any student with an average percentage below 40% or a composite Risk Score &ge; 45% is flagged automatically with an alert icon.</p>
                </div>
            </div>

            <div class="step-card">
                <div class="step-num">4</div>
                <div>
                    <h5 class="h6 fw-bold mb-1">Determining Learning Modality (VARK Assessment)</h5>
                    <p class="text-muted small mb-0">Open the student details page (<code>/Students/Details/{id}</code>) to conduct the 4-question VARK quiz. Identifies whether the student learns best through <strong>Visual</strong>, <strong>Auditory</strong>, <strong>Reading/Writing</strong>, or <strong>Kinesthetic (Hands-on)</strong> methods.</p>
                </div>
            </div>

            <div class="step-card">
                <div class="step-num">5</div>
                <div>
                    <h5 class="h6 fw-bold mb-1">Creating & Executing a Remedial Plan</h5>
                    <p class="text-muted small mb-0">Click <strong>Create Remedial Plan</strong> from the student's profile. Choose an innovative teaching strategy from the library or click <strong>✨ Generate with AI</strong> to generate a structured 4-week remedial agenda tailored to the student's learning style.</p>
                </div>
            </div>

            <div class="step-card">
                <div class="step-num">6</div>
                <div>
                    <h5 class="h6 fw-bold mb-1">Tracking Progress Logs</h5>
                    <p class="text-muted small mb-0">Each week, record a <code>ProgressLog</code> inside the active remedial plan (topics covered, intervention notes, and post-intervention test score). Once target score is reached, mark the plan as <strong>Completed</strong>.</p>
                </div>
            </div>
        </section>

        <!-- SECTION 3: ADMINISTRATOR GUIDE -->
        <section class="docs-section" id="admin-guide">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="docs-badge docs-badge-admin">Admin Guide</span>
            </div>
            <h2 class="h3 fw-bold mb-3">Administrator Governance & Institution Setup</h2>
            <p class="text-muted">
                Administrators oversee institutional master data, configure pedagogical catalogs, run school-wide cohort diagnostics, and audit teacher intervention records.
            </p>

            <div class="table-responsive my-3">
                <table class="table table-bordered table-sm align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>Administrative Capability</th>
                            <th>Route</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Subject Master Catalog</strong></td>
                            <td><code>/Subjects</code></td>
                            <td>Add, update, or retire academic disciplines (e.g., Mathematics, Physics, English).</td>
                        </tr>
                        <tr>
                            <td><strong>Innovative Methods Library</strong></td>
                            <td><code>/InnovativeMethods</code></td>
                            <td>Curate teaching strategies (Peer Tutoring, Gamified Quizzes, Mind Mapping) categorized by learning styles.</td>
                        </tr>
                        <tr>
                            <td><strong>Cohort Detection Trigger</strong></td>
                            <td><code>/SlowLearners/RunDetection</code></td>
                            <td>Execute a school-wide recalculation of risk scores across all active students and assessments.</td>
                        </tr>
                        <tr>
                            <td><strong>CSV Performance Export</strong></td>
                            <td><code>/SlowLearners/ExportCsv</code></td>
                            <td>Download school-wide diagnostic reports generated from the <code>vw_StudentPerformance</code> reporting view.</td>
                        </tr>
                        <tr>
                            <td><strong>User & Role Governance</strong></td>
                            <td><code>/Identity/Account</code></td>
                            <td>Promote registered teachers to Admin, review profile claims, and audit security settings.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="docs-callout docs-callout-warning">
                <strong>Admin Protection Note:</strong> The <code>/Subjects</code> and <code>/InnovativeMethods</code> creation/editing routes are restricted with <code>[Authorize(Roles = "Admin")]</code>. Teachers attempting to access these endpoints receive an HTTP 403 Forbidden.
            </div>
        </section>

        <!-- SECTION 3B: DEVELOPER SETUP -->
        <section class="docs-section" id="developer-guide">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="docs-badge docs-badge-dev">Developer Guide</span>
            </div>
            <h2 class="h3 fw-bold mb-3">Developer Environment &amp; Solution Architecture</h2>
            <p class="text-muted">
                EduBoost targets <strong>.NET 10</strong> with Entity Framework Core, SQL Server LocalDB, ASP.NET Core Identity, Swashbuckle OpenAPI, and an xUnit test suite in <code>tests/EduBoost.Tests</code>.
            </p>

            <div class="table-responsive my-3">
                <table class="table table-bordered table-sm align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>Folder / File</th>
                            <th>Responsibility</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>Program.cs</code></td>
                            <td>Registers DbContext, Identity + Roles, optional Google OAuth, Session, <code>ISlowLearnerService</code>, <code>IAiPlanService</code> (25s timeout), <code>IGeminiChatService</code> (7s timeout), Swagger, and startup seeding.</td>
                        </tr>
                        <tr>
                            <td><code>Controllers/Api/</code></td>
                            <td><code>StudentsApiController.cs</code> (<code>/api/students</code>) &amp; <code>ChatbotController.cs</code> (<code>/api/chatbot</code>).</td>
                        </tr>
                        <tr>
                            <td><code>Services/</code></td>
                            <td><code>SlowLearnerService.cs</code>, <code>AiPlanService.cs</code>, and <code>GeminiChatService.cs</code>.</td>
                        </tr>
                        <tr>
                            <td><code>Data/Sql/ReportingObjects.sql</code></td>
                            <td>Defines SQL view <code>vw_StudentPerformance</code> and stored procedure <code>sp_GetSlowLearners</code>.</td>
                        </tr>
                        <tr>
                            <td><code>Middleware/RequestLoggingMiddleware.cs</code></td>
                            <td>Logs request method, path, status code, and execution duration.</td>
                        </tr>
                        <tr>
                            <td><code>tests/EduBoost.Tests/</code></td>
                            <td>xUnit unit tests (<code>SlowLearnerRiskTests.cs</code>) validating risk scoring, clamping, and AI fallback behavior.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="code-box">
                <div class="code-box-header">
                    <span>PowerShell / CLI Quickstart</span>
                </div>
                <pre class="mb-0"><code># Restore &amp; build solution
dotnet build

# Run application (default route: /Dashboard, Swagger: /swagger)
dotnet run

# Run xUnit unit tests
dotnet test

# Apply EF Core migrations manually
dotnet ef database update</code></pre>
            </div>
        </section>

        <!-- SECTION 4: DIAGNOSTIC RISK ENGINE -->
        <section class="docs-section" id="risk-engine">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="docs-badge docs-badge-dev">Engine Spec</span>
            </div>
            <h2 class="h3 fw-bold mb-3">Diagnostic Risk Engine Algorithm</h2>
            <p class="text-muted">
                EduBoost evaluates students using a multi-factor weighted predictive risk score implemented in <code>Services/SlowLearnerService.cs</code> (<code>ApplyRiskCalculation</code>).
            </p>

            <div class="p-3 rounded-4 border bg-dark text-white my-3">
                <div class="text-uppercase small text-muted fw-bold mb-2">Mathematical Risk Formula (Clamped 0–100):</div>
                <div class="font-monospace fs-6" style="color: #38bdf8;">
                    RiskScore = Clamp(((100 - AvgMarks) &times; 0.60) + ((100 - Attendance) &times; 0.25) + (Max(0, -(Last - First)) &times; 0.15), 0, 100)
                </div>
            </div>

            <h5 class="h6 fw-bold mt-4 mb-2">Factor Breakdowns:</h5>
            <ul class="text-muted small">
                <li><strong>Marks Deficit (60% Weight):</strong> <code>100 - AveragePercentage</code> across all recorded assessments for the student.</li>
                <li><strong>Attendance Deficit (25% Weight):</strong> <code>100 - AttendancePercent</code>. Low attendance significantly increases vulnerability.</li>
                <li><strong>Trajectory Trend Deficit (15% Weight):</strong> Compares the chronological latest score against the first score (<code>trend = marks.Last() - marks.First()</code>). When declining, <code>Max(0, -trend)</code> is weighted at 15%; if stable or improving, penalty is <code>0</code>.</li>
                <li><strong>Zero-Assessment Baseline:</strong> When no assessments exist yet, risk defaults to <code>(100 - AttendancePercent) &times; 0.25</code>.</li>
            </ul>

            <div class="docs-callout docs-callout-tip">
                <strong>Slow Learner Flag Condition:</strong><br />
                A student is flagged as <code>IsSlowLearner = true</code> when:
                <br />
                &bull; <code>AveragePercentage &lt; 40.0%</code> OR<br />
                &bull; <code>RiskScore &ge; 45.0</code>
            </div>
