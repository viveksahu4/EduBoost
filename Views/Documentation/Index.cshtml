@section Scripts {
    <script>
        function filterDocs() {
            const input = document.getElementById('docsSearchInput').value.toLowerCase();
            const links = document.querySelectorAll('#docsNavMenu .docs-nav-link');
            
            links.forEach(link => {
                const text = link.textContent.toLowerCase();
                link.style.display = text.includes(input) ? 'flex' : 'none';
            });
        }

        // Active link spy on scroll
        window.addEventListener('scroll', function () {
            const sections = document.querySelectorAll('.docs-section');
            const navLinks = document.querySelectorAll('#docsNavMenu .docs-nav-link');
            let current = '';

            sections.forEach(section => {
                const sectionTop = section.offsetTop - 120;
                if (pageYOffset >= sectionTop) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href') === `#${current}`) {
                    link.classList.add('active');
                }
            });
        });
    </script>
}
