@model IEnumerable<EduBoost.Models.Student>
@{
    ViewData["Title"] = "Slow Learners Support Hub";
    var list = Model.ToList();
    var flaggedCount = list.Count;
    var avgRisk = flaggedCount > 0 ? list.Average(s => s.RiskScore) : 0;
    var maxRisk = list.Any() ? list.Max(s => s.RiskScore) : 0;
    var avgAttendance = flaggedCount > 0 ? list.Average(s => s.AttendancePercent) : 0;
    var criticalCount = list.Count(s => s.RiskScore >= 60);
}

<div class="page-head mb-4">
    <div>
        <span class="eyebrow">Diagnostic Engine & Early Intervention</span>
        <h1 class="text-gradient mb-1">Students Needing Remedial Support</h1>
        <p class="text-muted mb-0" style="font-size: 0.92rem;">
            Automated detection combining weighted marks (60%), attendance fidelity (25%), and negative performance trends (15%).
        </p>
    </div>
    <div class="page-head-actions d-flex flex-wrap align-items-center gap-2">
        <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" asp-action="ExportCsv" title="Download audit CSV report">
            <svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Export CSV</span>
        </a>
        <a class="btn btn-outline-info d-inline-flex align-items-center gap-2" asp-action="FromStoredProcedure" target="_blank" title="Inspect output from SQL stored procedure">
            <svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
            </svg>
            <span>Stored Proc</span>
        </a>
        <form asp-action="RunDetection" method="post" class="d-inline">
            <button class="btn btn-danger d-inline-flex align-items-center gap-2" type="submit">
                <svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
                <span>Run Detection Now</span>
            </button>
        </form>
    </div>
</div>

<!-- Diagnostic KPI Row -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-top">
                <div>
                    <p class="kpi-label">Flagged Candidates</p>
                    <p class="kpi-value" style="color: #ef4444;">@flaggedCount</p>
                </div>
                <span class="kpi-icon" style="color: #ef4444;" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                </span>
            </div>
            <div class="kpi-meta">
                <span class="badge bg-danger-subtle text-danger fw-semibold">@criticalCount Critical</span>
                <span class="text-muted ms-auto">Requires support</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-top">
                <div>
                    <p class="kpi-label">Cohort Risk Average</p>
                    <p class="kpi-value">@avgRisk.ToString("0.0")</p>
                </div>
                <span class="kpi-icon" style="color: #f59e0b;" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 14 14"></polyline>
                    </svg>
                </span>
            </div>
            <div class="kpi-meta">
                <span class="badge bg-warning-subtle text-warning fw-semibold">Threshold: >= 45.0</span>
                <span class="text-muted ms-auto">Out of 100</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-top">
                <div>
                    <p class="kpi-label">Peak Risk Score</p>
                    <p class="kpi-value" style="color: #ef4444;">@maxRisk.ToString("0.0")</p>
                </div>
                <span class="kpi-icon" style="color: #ef4444;" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                        <polyline points="17 6 23 6 23 12"></polyline>
                    </svg>
                </span>
            </div>
            <div class="kpi-meta">
                <span class="badge bg-danger-subtle text-danger fw-semibold">Immediate Priority</span>
                <span class="text-muted ms-auto">Highest severity</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-top">
                <div>
                    <p class="kpi-label">Avg Attendance</p>
                    <p class="kpi-value">@avgAttendance.ToString("0.#")%</p>
                </div>
                <span class="kpi-icon" style="color: #06b6d4;" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <polyline points="16 11 18 13 22 9"></polyline>
                    </svg>
                </span>
            </div>
            <div class="kpi-meta">
                <span class="badge bg-info-subtle text-info fw-semibold">Sync: vw_StudentPerformance</span>
                <span class="text-muted ms-auto">EF Core Synced</span>
            </div>
        </div>
    </div>
</div>

<!-- Formula Explainer Banner -->
<div class="formula-card mb-4 reveal">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-2">
        <div>
            <h2 class="h6 fw-bold mb-1 text-primary">Multi-Factor Risk Diagnostic Model</h2>
            <p class="text-muted small mb-0">Every student is analyzed through a weighted 3-dimensional academic equation.</p>
        </div>
        <span class="badge" style="background: rgba(37, 99, 235, 0.1); color: #2563eb; font-weight: 600; padding: 6px 12px; border-radius: 8px;">
            Trigger Rule: Risk ≥ 45 OR Average Marks &lt; 40%
        </span>
    </div>
    <div class="d-flex flex-wrap gap-2 pt-2">
        <div class="formula-step">
            <span class="formula-step-pct">60%</span>
            <span>Assessment Marks (Inverse Performance)</span>
        </div>
        <div class="formula-step">
            <span class="formula-step-pct">25%</span>
            <span>Attendance Deficit (&lt; 75% Benchmark)</span>
        </div>
        <div class="formula-step">
            <span class="formula-step-pct">15%</span>
            <span>Negative Trend (Declining trajectory)</span>
        </div>
    </div>
</div>

@if (!list.Any())
{
    <div class="card glass-card text-center p-5 reveal">
        <div class="empty-icon fs-1 mb-2">🎉</div>
        <h3 class="h5 fw-bold mb-1">No Slow Learners Currently Flagged</h3>
        <p class="text-muted mb-3" style="max-width: 480px; margin: 0 auto;">
            All students are currently meeting expected benchmarks (Risk Score &lt; 45 and Marks &gt;= 40%). Run detection whenever new exam scores are logged.
        </p>
        <form asp-action="RunDetection" method="post" class="d-inline">
            <button class="btn btn-primary" type="submit">Re-Run Detection Engine</button>
        </form>
    </div>
}
else
{
    <!-- High Risk Candidates Table Card -->
    <div class="card glass-card reveal">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h2 class="h5 fw-bold mb-0">Intervention Candidate Roster</h2>
                <p class="panel-sub mb-0">Ranked by overall risk severity score for targeted remedial action.</p>
            </div>
            <span class="chip chip-rose">@flaggedCount Students Flagged</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 25%;">Student</th>
                        <th>Class</th>
                        <th>Attendance</th>
                        <th>Learning Style</th>
                        <th style="width: 22%;">Risk Meter</th>
                        <th class="text-end">Remedial Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in list)
                    {
                        var initials = string.Concat(student.FullName
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(part => char.ToUpperInvariant(part[0])));
                        var isCritical = student.RiskScore >= 60;

                        string styleChip = "chip-blue";
                        string styleIcon = "👁️";
                        if (student.LearningStyle.Contains("Audit", StringComparison.OrdinalIgnoreCase)) { styleChip = "chip-purple"; styleIcon = "🎧"; }
                        else if (student.LearningStyle.Contains("Kinest", StringComparison.OrdinalIgnoreCase)) { styleChip = "chip-amber"; styleIcon = "🏃"; }
                        else if (student.LearningStyle.Contains("Read", StringComparison.OrdinalIgnoreCase) || student.LearningStyle.Contains("Write", StringComparison.OrdinalIgnoreCase)) { styleChip = "chip-emerald"; styleIcon = "📖"; }

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar" style="width: 40px; height: 40px; border-radius: 10px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25); display: flex; align-items: center; justify-content: center; font-weight: 700; color: #ef4444;">
                                        @initials
                                    </div>
                                    <div>
                                        <span class="fw-bold d-block" style="color: var(--text);">@student.FullName</span>
                                        <span class="text-muted small">Roll: @student.RollNo</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge" style="background: var(--surface-soft); color: var(--text); border: 1px solid var(--border); font-weight: 500; padding: 4px 8px; border-radius: 6px;">
                                    @student.ClassName
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-semibold @(student.AttendancePercent < 75 ? "text-danger" : "text-success")">
                                        @student.AttendancePercent.ToString("0.#")%
                                    </span>
                                    @if (student.AttendancePercent < 75)
                                    {
                                        <span class="badge bg-danger-subtle text-danger" style="font-size: 0.7rem;">Low</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="chip @styleChip">
                                    <span>@styleIcon</span>
                                    <span>@student.LearningStyle</span>
                                </span>
                            </td>
                            <td>
                                @{
                                    var riskWidth = Math.Clamp(student.RiskScore, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                                }
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress-mini flex-grow-1">
                                        <div class="progress-bar @(isCritical ? "bg-danger" : "bg-warning")"
                                             role="progressbar"
                                             aria-valuenow="@riskWidth" aria-valuemin="0" aria-valuemax="100"
                                             style="width: @(riskWidth)%"></div>
                                    </div>
                                    <span class="chip @(isCritical ? "chip-rose" : "chip-amber")">
                                        @student.RiskScore.ToString("0.0")
                                    </span>
                                </div>
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary me-1" asp-controller="Students" asp-action="Details" asp-route-id="@student.Id" style="border-radius: 8px;">
                                    Profile
                                </a>
                                <a class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" asp-controller="RemedialPlans" asp-action="Create" asp-route-studentId="@student.Id" style="border-radius: 8px;">
                                    <svg class="icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    <span>Create Plan</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
