@model EduBoost.Models.InnovativeMethod
@{
    ViewData["Title"] = "Delete Innovative Method";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Delete Innovative Method</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to library</a>
</div>

<div class="alert alert-danger">
    Are you sure you want to remove <strong>@Model.Name</strong> from the library?
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Category</dd>
            <dt class="col-sm-3">Learning style</dt><dd class="col-sm-9">@Model.SuitableLearningStyle</dd>
            <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete method</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
