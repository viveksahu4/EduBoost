@model IEnumerable<EduBoost.Models.Subject>
@{
    ViewData["Title"] = "Academic Subjects";
    var subjectsList = Model.ToList();
    var totalSubjects = subjectsList.Count;
    var totalAssessments = subjectsList.Sum(s => s.Assessments?.Count ?? 0);
    var avgAssessments = totalSubjects > 0 ? (double)totalAssessments / totalSubjects : 0;
    var maxAssessments = subjectsList.Any() ? Math.Max(1, subjectsList.Max(s => s.Assessments?.Count ?? 0)) : 1;
}

<div class="page-head mb-4">
    <div>
        <span class="eyebrow">Curriculum & Disciplines</span>
        <h1 class="text-gradient mb-1">Academic Subjects</h1>
        <p class="text-muted mb-0" style="font-size: 0.92rem;">
            Manage academic departments, assessment volume, and track curriculum performance across disciplines.
        </p>
    </div>
    <div class="page-head-actions d-flex align-items-center gap-2">
        <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" asp-controller="Assessments" asp-action="Index">
            <svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <span>View All Assessments</span>
        </a>
        <a class="btn btn-primary d-inline-flex align-items-center gap-2" asp-action="Create">
            <svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>+ Add Subject</span>
        </a>
    </div>
</div>

<!-- Executive Metric Row -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-top">
                <div>
                    <p class="kpi-label">Total Subjects</p>
                    <p class="kpi-value">@totalSubjects</p>
                </div>
                <span class="kpi-icon" style="color: #2563eb;" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                    </svg>
                </span>
            </div>
            <div class="kpi-meta">
                <span class="badge bg-success-subtle text-success fw-semibold">100% Active</span>
                <span class="text-muted ms-auto">Core disciplines</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-top">
                <div>
                    <p class="kpi-label">Assessments Logged</p>
                    <p class="kpi-value">@totalAssessments</p>
                </div>
                <span class="kpi-icon" style="color: #10b981;" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                    </svg>
                </span>
            </div>
            <div class="kpi-meta">
                <span class="badge bg-success-subtle text-success fw-semibold">+14% vs prev. month</span>
                <span class="text-muted ms-auto">Continuous eval</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-top">
                <div>
                    <p class="kpi-label">Average Tests / Subject</p>
                    <p class="kpi-value">@avgAssessments.ToString("0.#")</p>
                </div>
                <span class="kpi-icon" style="color: #8b5cf6;" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </span>
            </div>
            <div class="kpi-meta">
                <span class="badge bg-primary-subtle text-primary fw-semibold">Balanced Volume</span>
                <span class="text-muted ms-auto">Cohort distribution</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-top">
                <div>
                    <p class="kpi-label">Curriculum Health</p>
                    <p class="kpi-value">Optimal</p>
                </div>
                <span class="kpi-icon" style="color: #06b6d4;" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </span>
            </div>
            <div class="kpi-meta">
                <span class="badge bg-info-subtle text-info fw-semibold">All subjects tracked</span>
                <span class="text-muted ms-auto">Early detection ON</span>
            </div>
        </div>
    </div>
</div>

@if (!subjectsList.Any())
{
    <div class="card glass-card text-center p-5 reveal">
        <div class="empty-icon fs-1 mb-2">📚</div>
        <h3 class="h5 fw-bold mb-1">No Academic Subjects Registered Yet</h3>
        <p class="text-muted mb-3" style="max-width: 480px; margin: 0 auto;">
            Get started by creating your core subjects (e.g., Mathematics, Science, English) to link assessments and remedial plans.
        </p>
        <div>
            <a class="btn btn-primary" asp-action="Create">+ Add First Subject</a>
        </div>
    </div>
}
else
{
    <!-- Subject Interactive Card Grid -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="h5 fw-bold mb-0">Department Modules</h2>
            <p class="text-muted small mb-0">Detailed view of subjects and examination frequency.</p>
        </div>
        <span class="chip chip-blue">@totalSubjects Modules Active</span>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var subject in subjectsList)
        {
            var count = subject.Assessments?.Count ?? 0;
            var pctOfTotal = totalAssessments > 0 ? (count * 100 / totalAssessments) : 0;
            var passCount = subject.Assessments?.Count(a => a.Percentage >= 40) ?? 0;
            var passRate = count > 0 ? (passCount * 100 / count) : 100;

            string iconBoxClass = "icon-box-blue";
            string iconEmoji = "🎓";
            string categoryName = "Core Curriculum";
            string chipClass = "chip-blue";

            if (subject.Name.Contains("Math", StringComparison.OrdinalIgnoreCase))
            {
                iconBoxClass = "icon-box-blue";
                iconEmoji = "📐";
                categoryName = "STEM & Analytical";
                chipClass = "chip-blue";
            }
            else if (subject.Name.Contains("Sci", StringComparison.OrdinalIgnoreCase))
            {
                iconBoxClass = "icon-box-emerald";
                iconEmoji = "🧪";
                categoryName = "Natural Sciences";
                chipClass = "chip-emerald";
            }
            else if (subject.Name.Contains("Eng", StringComparison.OrdinalIgnoreCase) || subject.Name.Contains("Lang", StringComparison.OrdinalIgnoreCase))
            {
                iconBoxClass = "icon-box-purple";
                iconEmoji = "📚";
                categoryName = "Language & Arts";
                chipClass = "chip-purple";
            }
            else
            {
                iconBoxClass = "icon-box-cyan";
                iconEmoji = "💡";
                categoryName = "Applied Studies";
                chipClass = "chip-amber";
            }

            <div class="col-md-6 col-xl-4">
                <div class="module-card h-100">
                    <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box-lg @iconBoxClass">
                                @iconEmoji
                            </div>
                            <div>
                                <h3 class="h5 fw-bold mb-1">@subject.Name</h3>
                                <span class="chip @chipClass">@categoryName</span>
                            </div>
                        </div>
                        <span class="badge" style="background: var(--surface-soft); color: var(--muted); border: 1px solid var(--border); font-size: 0.75rem;">
                            SUB-0@subject.Id
                        </span>
                    </div>

                    <div class="p-3 mb-3" style="background: var(--surface-soft); border-radius: 14px; border: 1px solid var(--border);">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-medium">Assessments Volume</span>
                            <span class="fw-bold small">@count Tests (@pctOfTotal%)</span>
                        </div>
                        <div class="progress-mini mb-2">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @Math.Min(100, (count * 100 / maxAssessments))%"></div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small text-muted">
                            <span>Passing Benchmark</span>
                            <span class="fw-semibold @(passRate >= 75 ? "text-success" : (passRate >= 50 ? "text-warning" : "text-danger"))">
                                @passRate% Pass Rate
                            </span>
                        </div>
                    </div>

                    <div class="mt-auto pt-2 border-top d-flex align-items-center justify-content-between" style="border-color: var(--border) !important;">
                        <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" asp-controller="Assessments" asp-action="Index" style="border-radius: 8px;">
                            <svg class="icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <span>Assessments</span>
                        </a>
                        <div class="d-flex gap-1">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@subject.Id" style="border-radius: 8px;" title="Edit Subject">
                                <svg class="icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                                <span>Edit</span>
                            </a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@subject.Id" style="border-radius: 8px;" title="Delete Subject">
                                <svg class="icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Data Table Card -->
    <div class="card glass-card reveal">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h2 class="h5 fw-bold mb-0">Curriculum Audit & Records</h2>
                <p class="panel-sub mb-0">Comprehensive record of enrolled subjects and diagnostic integration.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="chip chip-emerald">All Systems Synced</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 35%;">Subject & Department</th>
                        <th>Classification</th>
                        <th>Assessments Logged</th>
                        <th>Share of Tests</th>
                        <th>Diagnostic Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var subject in subjectsList)
                    {
                        var count = subject.Assessments?.Count ?? 0;
                        var pctOfTotal = totalAssessments > 0 ? (count * 100 / totalAssessments) : 0;
                        string iconEmoji = subject.Name.Contains("Math", StringComparison.OrdinalIgnoreCase) ? "📐" :
                                           (subject.Name.Contains("Sci", StringComparison.OrdinalIgnoreCase) ? "🧪" :
                                           (subject.Name.Contains("Eng", StringComparison.OrdinalIgnoreCase) ? "📚" : "💡"));
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar" style="background: var(--surface-soft); border: 1px solid var(--border); font-size: 1.1rem; width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                        @iconEmoji
                                    </div>
                                    <div>
                                        <span class="fw-bold text-dark d-block" style="color: var(--text) !important;">@subject.Name</span>
                                        <span class="text-muted small">Code: SUB-00@subject.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge" style="background: var(--surface-soft); color: var(--text); border: 1px solid var(--border); border-radius: 6px; padding: 4px 8px; font-weight: 500;">
                                    Core Academic
                                </span>
                            </td>
                            <td>
                                <span class="fw-bold">@count</span>
                                <span class="text-muted small"> assessments</span>
                            </td>
                            <td style="min-width: 140px;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress-mini flex-grow-1">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @pctOfTotal%"></div>
                                    </div>
                                    <span class="small text-muted fw-semibold">@pctOfTotal%</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-success d-inline-flex align-items-center gap-1" style="border-radius: 6px; padding: 4px 8px;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #10b981;"></span>
                                    Active Monitored
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@subject.Id" style="border-radius: 8px;">
                                    Edit
                                </a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@subject.Id" style="border-radius: 8px;">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
