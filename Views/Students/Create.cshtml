@model EduBoost.Models.Student
@{
    ViewData["Title"] = "Add Student";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Add Student</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="RollNo" class="form-label"></label>
                            <input asp-for="RollNo" class="form-control" placeholder="S11" />
                            <span asp-validation-for="RollNo" class="text-danger"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Student full name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ClassName" class="form-label"></label>
                            <input asp-for="ClassName" class="form-control" placeholder="8-A" />
                            <span asp-validation-for="ClassName" class="text-danger"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="ParentEmail" class="form-label"></label>
                            <input asp-for="ParentEmail" class="form-control" placeholder="parent@example.com" />
                            <span asp-validation-for="ParentEmail" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AttendancePercent" class="form-label"></label>
                            <input asp-for="AttendancePercent" class="form-control" type="number" step="0.1" min="0" max="100" />
                            <span asp-validation-for="AttendancePercent" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LearningStyle" class="form-label"></label>
                            <select asp-for="LearningStyle" class="form-select">
                                <option value="Visual">Visual</option>
                                <option value="Auditory">Auditory</option>
                                <option value="Reading">Reading</option>
                                <option value="Kinesthetic">Kinesthetic</option>
                            </select>
                            <span asp-validation-for="LearningStyle" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Save student</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
