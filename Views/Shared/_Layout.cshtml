@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var pageTitle = ViewData["Title"] as string ?? "Dashboard";
    string NavClass(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "sidebar-link active"
            : "sidebar-link";
    string NavAria(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "page"
            : "false";
}
<!DOCTYPE html>
<html lang="en" data-theme="light" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f6fa" />
    <meta name="description" content="EduBoost — slow learner identification and remedial teaching analytics." />
    <title>@ViewData["Title"] - EduBoost</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    @* Apply the saved theme before first paint to avoid a flash. *@
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('eduboost-theme') || 'light';
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.setAttribute('data-bs-theme', theme);
            } catch (e) { }
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduBoost.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <a class="skip-link" href="#mainContent">Skip to content</a>

    <div class="app-shell">
        <aside class="sidebar" id="appSidebar" aria-label="Primary navigation">
            <a class="brand" asp-area="" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">🎓</span>
                <span class="brand-text">
                    <span class="brand-name">EduBoost</span>
                    <span class="brand-sub">Learning analytics</span>
                </span>
            </a>

            <nav class="sidebar-nav" aria-label="Main menu">
                <div class="nav-section-label">Overview</div>
                <a class="@NavClass("Dashboard")" aria-current="@NavAria("Dashboard")"
                   asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <rect x="3" y="3" width="7" height="7" rx="1.5" />
                        <rect x="14" y="3" width="7" height="7" rx="1.5" />
                        <rect x="3" y="14" width="7" height="7" rx="1.5" />
                        <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    </svg>
                    <span>Dashboard</span>
                </a>

                <div class="nav-section-label">Learning</div>
                <a class="@NavClass("Students")" aria-current="@NavAria("Students")"
                   asp-area="" asp-controller="Students" asp-action="Index">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    <span>Students</span>
                </a>
                <a class="@NavClass("Assessments")" aria-current="@NavAria("Assessments")"
                   asp-area="" asp-controller="Assessments" asp-action="Index">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                        <rect x="9" y="3" width="6" height="4" rx="1" />
                        <path d="M9 12h6" />
                        <path d="M9 16h4" />
                    </svg>
                    <span>Assessments</span>
                </a>
                <a class="@NavClass("SlowLearners")" aria-current="@NavAria("SlowLearners")"
                   asp-area="" asp-controller="SlowLearners" asp-action="Index">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="m10.29 3.86-8.18 14A2 2 0 0 0 3.82 21h16.36a2 2 0 0 0 1.71-3.14l-8.18-14a2 2 0 0 0-3.42 0Z" />
                        <path d="M12 9v4" />
                        <path d="M12 17h.01" />
                    </svg>
                    <span>Slow Learners</span>
                </a>
                <a class="@NavClass("RemedialPlans")" aria-current="@NavAria("RemedialPlans")"
                   asp-area="" asp-controller="RemedialPlans" asp-action="Index">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" />
                    </svg>
                    <span>Remedial Plans</span>
                </a>
                <a class="@NavClass("InnovativeMethods")" aria-current="@NavAria("InnovativeMethods")"
                   asp-area="" asp-controller="InnovativeMethods" asp-action="Index">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M15 14c.2-1 .7-1.7 1.5-2.5A5 5 0 1 0 7.5 11.5c.8.8 1.3 1.5 1.5 2.5" />
                        <path d="M9 18h6" />
                        <path d="M10 22h4" />
                    </svg>
                    <span>Methods</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <div class="nav-section-label">Administration</div>
                    <a class="@NavClass("Subjects")" aria-current="@NavAria("Subjects")"
                       asp-area="" asp-controller="Subjects" asp-action="Index">
                        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z" />
                            <path d="m22 12.5-9.17 4.16a2 2 0 0 1-1.66 0L2 12.5" />
                            <path d="m22 17.5-9.17 4.16a2 2 0 0 1-1.66 0L2 17.5" />
                        </svg>
                        <span>Subjects</span>
                    </a>
                }

                <div class="nav-section-label">Developer & Resources</div>
                <a class="@NavClass("Documentation")" aria-current="@NavAria("Documentation")"
                   asp-area="" asp-controller="Documentation" asp-action="Index">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" />
                        <line x1="9" y1="7" x2="15" y2="7" />
                        <line x1="9" y1="11" x2="13" y2="11" />
                    </svg>
                    <span>Documentation Hub</span>
                </a>
                <a class="sidebar-link" href="/swagger" target="_blank" rel="noopener noreferrer">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                    <span>API Docs (Swagger)</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-note">
                    <span class="sidebar-note-icon" aria-hidden="true">✨</span>
                    <strong>AI remedial plans</strong>
                    <p>Turn a risk profile into a four-week support plan in seconds.</p>
                    <a class="btn btn-glow btn-sm w-100 mt-2" asp-controller="SlowLearners" asp-action="Index">
                        Review learners
                    </a>
                </div>
                <div class="sidebar-version">EduBoost v1.0 · .NET 10</div>
            </div>
        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

        <div class="app-main">
            <header class="topbar">
                <button class="icon-btn" id="sidebarToggle" type="button"
                        aria-controls="appSidebar" aria-expanded="true" aria-label="Toggle navigation">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M4 6h16" />
                        <path d="M4 12h16" />
                        <path d="M4 18h16" />
                    </svg>
                </button>

                <div class="topbar-title">
                    <span class="topbar-eyebrow">Workspace</span>
                    <span class="topbar-page">@pageTitle</span>
                </div>

                <form class="topbar-search" role="search" method="get"
                      asp-area="" asp-controller="Students" asp-action="Index">
                    <svg class="icon search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m21 21-4.3-4.3" />
                    </svg>
                    <input class="form-control" type="search" name="search"
                           placeholder="Search students, roll no, class…" aria-label="Search students" />
                </form>

                <button type="button" class="theme-toggle-btn" id="themeToggleBtn"
                        aria-label="Toggle dark/light mode" title="Switch between Light (Off-white) and Dark mode">
                    <span class="theme-toggle-icon icon-sun" aria-hidden="true">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2" />
                            <path d="M12 20v2" />
                            <path d="m4.93 4.93 1.41 1.41" />
                            <path d="m17.66 17.66 1.41 1.41" />
                            <path d="M2 12h2" />
                            <path d="M20 12h2" />
                            <path d="m6.34 17.66-1.41 1.41" />
                            <path d="m19.07 4.93-1.41 1.41" />
                        </svg>
                    </span>
                    <span class="theme-toggle-icon icon-moon" aria-hidden="true">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
                        </svg>
                    </span>
                    <span class="theme-toggle-label d-none d-sm-inline" id="themeToggleLabel">Light</span>
                </button>

                <div class="topbar-actions">
                    <partial name="_NotificationDropdown" />
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <main class="app-content" id="mainContent">
                <partial name="_Alerts" />
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; 2026 EduBoost &middot; Slow learner identification &amp; remedial teaching</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script>
        // Prevent a sidebar flash for users who left it collapsed.
        (function () {
            try {
                if (localStorage.getItem('eduboost-sidebar-collapsed') === '1' &&
                    !window.matchMedia('(max-width: 991.98px)').matches) {
                    document.body.classList.add('sidebar-collapsed');
                }
            } catch (e) { }
        })();
    </script>

    <partial name="_ChatbotWidget" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
