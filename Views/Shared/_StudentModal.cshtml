<div class="modal fade" id="studentModal" tabindex="-1" aria-labelledby="studentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-area="" asp-controller="Students" asp-action="Create" method="post">
                <div class="modal-header">
                    <div>
                        <span class="eyebrow">New record</span>
                        <h2 class="modal-title h5" id="studentModalLabel">Add a student</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="newStudentRollNo">Roll No</label>
                            <input class="form-control" id="newStudentRollNo" name="RollNo"
                                   maxlength="20" placeholder="S11" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label" for="newStudentName">Full name</label>
                            <input class="form-control" id="newStudentName" name="FullName"
                                   maxlength="100" placeholder="Student full name" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="newStudentClass">Class</label>
                            <input class="form-control" id="newStudentClass" name="ClassName"
                                   maxlength="30" placeholder="8-A" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label" for="newStudentEmail">Parent email</label>
                            <input class="form-control" id="newStudentEmail" name="ParentEmail"
                                   type="email" maxlength="150" placeholder="parent@example.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="newStudentAttendance">Attendance (%)</label>
                            <input class="form-control" id="newStudentAttendance" name="AttendancePercent"
                                   type="number" min="0" max="100" step="0.1" value="90" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="newStudentStyle">Learning style</label>
                            <select class="form-select" id="newStudentStyle" name="LearningStyle">
                                <option value="Visual">Visual</option>
                                <option value="Auditory">Auditory</option>
                                <option value="Reading">Reading</option>
                                <option value="Kinesthetic">Kinesthetic</option>
                            </select>
                        </div>
                    </div>

                    <p class="form-hint mt-3 mb-0">
                        The record is saved through the Students controller and appears in the
                        Students module with the same validation rules.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-glow">Save student</button>
                </div>
            </form>
        </div>
    </div>
</div>
