@model EduBoost.Models.Assessment
@{
    ViewData["Title"] = "Edit Assessment";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Edit Assessment</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StudentId" class="form-label">Student</label>
                            <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId"></select>
                            <span asp-validation-for="StudentId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SubjectId" class="form-label">Subject</label>
                            <select asp-for="SubjectId" class="form-select" asp-items="ViewBag.SubjectId"></select>
                            <span asp-validation-for="SubjectId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExamType" class="form-label"></label>
                            <input asp-for="ExamType" class="form-control" />
                            <span asp-validation-for="ExamType" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExamDate" class="form-label"></label>
                            <input asp-for="ExamDate" class="form-control" type="date" />
                            <span asp-validation-for="ExamDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MarksObtained" class="form-label"></label>
                            <input asp-for="MarksObtained" class="form-control" type="number" step="0.1" min="0" />
                            <span asp-validation-for="MarksObtained" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MaxMarks" class="form-label"></label>
                            <input asp-for="MaxMarks" class="form-control" type="number" step="0.1" min="1" />
                            <span asp-validation-for="MaxMarks" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Save changes</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
