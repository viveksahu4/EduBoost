@model EduBoost.Models.Assessment
@{
    ViewData["Title"] = "Assessment Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Assessment Details</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Student</dt>
            <dd class="col-sm-9">
                @if (Model.Student != null)
                {
                    <a asp-controller="Students" asp-action="Details" asp-route-id="@Model.StudentId">@Model.Student.FullName</a>
                }
                else
                {
                    <span>-</span>
                }
            </dd>
            <dt class="col-sm-3">Subject</dt><dd class="col-sm-9">@Model.Subject?.Name</dd>
            <dt class="col-sm-3">Exam</dt><dd class="col-sm-9">@Model.ExamType</dd>
            <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.ExamDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Marks</dt><dd class="col-sm-9">@Model.MarksObtained.ToString("0.#") / @Model.MaxMarks.ToString("0.#")</dd>
            <dt class="col-sm-3">Percentage</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Percentage < 40 ? "bg-danger" : Model.Percentage < 60 ? "bg-warning text-dark" : "bg-success")">
                    @Model.Percentage.ToString("0.#")%
                </span>
            </dd>
        </dl>

        <div class="mt-4">
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
        </div>
    </div>
</div>
